#!/bin/bash
{{ if eq .machineType "devcontainer" -}}
# In devcontainer: keep existing .zshrc and append our config
cat
cat <<'CHEZMOI_APPEND'

# --- chezmoi managed ---
ZSH_THEME="refined"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
source $ZSH/oh-my-zsh.sh
export TERM=xterm-256color
export COLORTERM=truecolor
alias reload='source ~/.zshrc'
gcol() { git checkout "$1" && git pull; }
gls() { local stashed=0; git diff --quiet HEAD || { git stash push && stashed=1; }; git pull; [ "$stashed" -eq 1 ] && git stash pop; }
alias cc="claude"
alias ccc="claude -c"
alias ccr="claude -r"
CHEZMOI_APPEND
{{ else -}}
# On other machines: replace .zshrc entirely
cat <<'CHEZMOI_REPLACE'
# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="refined"

{{ if eq .machineType "work" -}}
plugins=(git docker zsh-autosuggestions zsh-syntax-highlighting)
{{ else -}}
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
{{ end -}}

source $ZSH/oh-my-zsh.sh

{{ if eq .machineType "work" -}}
[ -f "$HOME/.secrets.zsh" ] && source "$HOME/.secrets.zsh"
source ${ENSUREIT_DIR}/bin/setenv.sh

# Docker CLI completions
fpath=($HOME/.docker/completions $fpath)
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

# Devcontainer aliases
devcrun() { devcontainer exec --workspace-folder . "$@" }
alias devczsh='devcrun zsh'
# Bring the current repo's devcontainer up HEADLESSLY (no VS Code). Main entrypoint.
devcup() {
  [ -f "$PWD/.devcontainer/devcontainer.json" ] || { echo "no .devcontainer/devcontainer.json" >&2; return 1; }
  devcontainer up --workspace-folder . || return
  # VS Code injects a docker credential helper (credsStore) that is absent when running
  # headless, which breaks `docker` inside the container (e.g. `make build.out`). Strip it.
  devcontainer exec --workspace-folder . python3 -c "import json,os; p='/root/.docker/config.json'; d=(json.load(open(p)) if os.path.exists(p) else {}); d.pop('credsStore',None); open(p,'w').write(json.dumps(d))" 2>/dev/null
  echo "devcontainer up (headless). enter a shell with: devczsh"
}

# Open the current repo's devcontainer in VS Code ("Reopen in Container")
devcode() {
  local host="$PWD"
  local cfg="$host/.devcontainer/devcontainer.json"
  local ws="${1:-/workspaces/$(basename "$host")}"
  [ -f "$cfg" ] || { echo "no $cfg" >&2; return 1; }
  local hex
  hex=$(python3 -c '
import json,sys,binascii
host,cfg=sys.argv[1],sys.argv[2]
obj={"hostPath":host,"localDocker":False,"settings":{"context":"desktop-linux"},
     "configFile":{"$mid":1,"fsPath":cfg,"external":"file://"+cfg,"path":cfg,"scheme":"file"}}
sys.stdout.write(binascii.hexlify(json.dumps(obj,separators=(",",":")).encode()).decode())
' "$host" "$cfg")
  code --folder-uri "vscode-remote://dev-container+${hex}${ws}"
}
alias devcstop='docker stop $(docker ps -q --filter "label=devcontainer.local_folder=$(pwd)")'
alias devcrm='docker rm -f $(docker ps -aq --filter "label=devcontainer.local_folder=$(pwd)")'
alias devcst='docker ps --filter "label=devcontainer.local_folder=$(pwd)" --format "{{ "{{.Names}}" }}\t{{ "{{.Status}}" }}"'
alias devcrb='devcontainer rebuild --workspace-folder .'

{{ end -}}

export COLORTERM=truecolor

# Consolidated PATH (guarded to avoid duplicates on reload)
[[ ":$PATH:" != *":$HOME/.bun/bin:"* ]] && export PATH="$HOME/.bun/bin:$PATH"
[[ ":$PATH:" != *":$HOME/.local/bin:"* ]] && export PATH="$HOME/.local/bin:$PATH"

# zoxide (smarter cd)
eval "$(zoxide init zsh)"

# fzf (fuzzy finder): Ctrl-R history, Ctrl-T file picker, Alt-C cd
source <(fzf --zsh)

# eza (modern ls)
alias ls='eza --icons'
alias ll='eza -l --icons'
alias la='eza -la --icons'

# bat (better cat)
alias cat='bat'
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# Unlock keychain
alias unlock='security unlock-keychain'

# Reload zsh config
alias reload='source ~/.zshrc'

# Git: checkout a branch and pull (gco + gl)
gcol() { git checkout "$1" && git pull; }

# Git: stash, pull, then pop the stash we just made (skips pop if nothing was stashed)
gls() {
  local stashed=0
  git diff --quiet HEAD || { git stash push && stashed=1; }
  git pull
  [ "$stashed" -eq 1 ] && git stash pop
}

# Claude Code aliases
alias cc="claude"
alias ccc="claude -c"
alias ccr="claude -r"
CHEZMOI_REPLACE
{{ end -}}
