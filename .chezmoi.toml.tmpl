{{- $machineType := "" -}}
{{- /* VS Code sets REMOTE_CONTAINERS; the headless devcontainer CLI (devcup) doesn't. */ -}}
{{- if or (env "REMOTE_CONTAINERS") (stat "/.dockerenv") -}}
{{-   $machineType = "devcontainer" -}}
{{- else if eq .chezmoi.os "darwin" -}}
{{-   $machineType = promptStringOnce . "machineType" "Machine type (work/personal)" -}}
{{- else -}}
{{-   $machineType = "linux" -}}
{{- end -}}

[data]
  machineType = {{ $machineType | quote }}
